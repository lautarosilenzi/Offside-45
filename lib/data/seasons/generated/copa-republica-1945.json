 "notes": [
  {
   "kind": "formato",
   "text": "Primer torneo nacional con clubes de todo el país. Los equipos de las ligas del interior jugaban por zonas (grupos A a D) a eliminación directa y los cuatro ganadores cruzaban en cuartos de final con cuatro equipos de Primera. Los grupos eran cuadros de eliminación, no tablas."
  },
  {
   "kind": "formato",
   "text": "Los cuatro equipos de Primera fueron los semifinalistas de la Copa Británica 1945 (Boca, Estudiantes, Ferro y Racing)."
  },
  {
   "kind": "dato",
   "text": "Las semifinales y la final se jugaron en marzo de 1946 y el desempate de la final recién el 18 de diciembre de 1946 (fechas confirmadas en Wikipedia)."
  }
 ],
